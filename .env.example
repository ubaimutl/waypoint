APP_ORIGIN=https://locator.example.com
ADMIN_PASSWORD_HASH=generate-with-node-scripts-setup.mjs
DEVICE_TOKEN=generate-with-node-scripts-setup.mjs
DEVICE_NAME=My phone
# The local HTTP port is reachable only on loopback. Put an HTTPS reverse proxy in front.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Optional restrictions for push providers. Empty accepts public HTTPS providers.
PUSH_ALLOWED_HOSTS=
# Explicit exception for a self-hosted push provider resolving to a private IP.
PUSH_PRIVATE_HOSTS=
